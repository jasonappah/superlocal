{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Superlocal",
  "version": "1.0.0",
  "identifier": "ceo.ryan.superlocal",
  "build": { "frontendDist": "../ui" },
  "app": {
    "windows": [],
    "security": { "csp": "default-src 'none'; style-src 'self'; base-uri 'none'; form-action 'none'; frame-src 'none'" }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "resources": ["resources/"],
    "category": "Productivity",
    "shortDescription": "Personal mail",
    "longDescription": "Keyboard-first personal mail served by a local Superlocal host."
  }
}
